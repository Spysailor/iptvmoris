              "border-radius": "16px !important",
              "background-color": "@card",
              "margin-left": "32px",
              "-webkit-flex": "none",
              "@media (max-width: 992px)": {
                "margin-left": "0",
                "margin-bottom": "32px",
                "padding": "64px 24px 24px",
                "margin-top": "32px"
              },
              "& when (@reverseContent)": {
                "margin-left": "0",
                "margin-right": "32px",
                "@media (max-width: 992px)": {
                  "margin-right": "0"
                }
              },
              ".title-wrap": {
                "margin-top": "-6rem",
                ".card-title": {
                  "display": "inline-flex",
                  "padding": "12px 24px",
                  "background-color": "@title",
                  "border-radius": ".5rem",
                  "box-shadow": "4px 6px 0 0 @shadow",
                  "margin-bottom": "40px"
                }
              },
